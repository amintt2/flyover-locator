{
  "manifest_version": 3,
  "name": "Flyover pour YouTube",
  "version": "0.1.0",
  "description": "Est-ce que cette vidéo peut contenir un passage d'avion ? Score rapide, puis envoi au serveur Flyover.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://flyover.mciut.fr/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "css": ["panel.css"]
  }],
  "icons": { "128": "icon128.png" }
}
